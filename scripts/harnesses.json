{
  "version": "1.162.0",
  "about": "Ассистенты (харнессы), к которым Аврора умеет подключить свой MCP-сервер. Каталог едет с китом: новая версия харнесса с другим местом настройки — правка этого файла в выпуске Авроры. Ищутся только нынешние версии: устаревшие места настройки не поддерживаются. Пути: {home} — домашняя папка; {appdata} — ~/Library/Application Support на macOS, ~/.config на Linux, %APPDATA% на Windows; {vscode} — {appdata}/Code/User. Форматы записи: standard — {command, args}; vscode — {type: stdio, command, args}; opencode — {type: local, command: [..], enabled}; crush — {type: stdio, command, args}; zed — {command, args, env, enabled}; codex — таблица TOML [mcp_servers.<имя>]; continue — свой файл YAML в папке mcpServers; hermes — YAML mcp_servers; goose — YAML extensions; chatbox — элемент списка settings.mcp.servers {id, name, enabled, transport: {type: stdio, command, args}} в config.json Chatbox, подключается только при закрытом приложении (process).",
  "harnesses": [
    {"id": "claude-code", "name": "Claude Code", "bins": ["claude"], "version_args": ["--version"],
     "config": "{home}/.claude.json", "format": "json", "key": "mcpServers", "entry": "standard",
     "cli_add": ["{bin}", "mcp", "add", "--scope", "user", "{name}", "--", "{command}", "{args}"],
     "note": "Добавляется командой самого Claude Code (claude mcp add --scope user): файл ~/.claude.json он ведёт сам. Срок вызова инструмента — переменная MCP_TOOL_TIMEOUT."},
    {"id": "claude-desktop", "name": "Claude Desktop", "bins": [],
     "detect": ["{appdata}/Claude"],
     "config": "{appdata}/Claude/claude_desktop_config.json", "format": "json", "key": "mcpServers",
     "entry": "standard", "note": "Перезапустите Claude Desktop."},
    {"id": "cursor", "name": "Cursor", "bins": ["cursor"], "version_args": ["--version"],
     "detect": ["{home}/.cursor", "/Applications/Cursor.app"],
     "config": "{home}/.cursor/mcp.json", "format": "json", "key": "mcpServers", "entry": "standard"},
    {"id": "windsurf", "name": "Windsurf", "bins": ["windsurf"], "version_args": ["--version"],
     "detect": ["{home}/.codeium/windsurf", "/Applications/Windsurf.app"],
     "config": "{home}/.codeium/windsurf/mcp_config.json", "format": "json", "key": "mcpServers",
     "entry": "standard"},
    {"id": "vscode", "name": "VS Code (Copilot)", "bins": ["code"], "version_args": ["--version"],
     "detect": ["{vscode}"],
     "config": "{vscode}/mcp.json", "format": "json", "key": "servers", "entry": "vscode"},
    {"id": "cline", "name": "Cline (VS Code)", "bins": [],
     "detect": ["{vscode}/globalStorage/saoudrizwan.claude-dev"],
     "config": "{vscode}/globalStorage/saoudrizwan.claude-dev/settings/cline_mcp_settings.json",
     "format": "json", "key": "mcpServers", "entry": "standard", "entry_extra": {"timeout": 1800}},
    {"id": "roo", "name": "Roo Code (VS Code)", "bins": [],
     "detect": ["{vscode}/globalStorage/rooveterinaryinc.roo-cline"],
     "config": "{vscode}/globalStorage/rooveterinaryinc.roo-cline/settings/mcp_settings.json",
     "format": "json", "key": "mcpServers", "entry": "standard", "entry_extra": {"timeout": 1800}},
    {"id": "kilo-code", "name": "Kilo Code (VS Code)", "bins": [],
     "detect": ["{vscode}/globalStorage/kilocode.kilo-code"],
     "config": "{vscode}/globalStorage/kilocode.kilo-code/settings/mcp_settings.json",
     "format": "json", "key": "mcpServers", "entry": "standard", "entry_extra": {"timeout": 1800}},
    {"id": "kilo-cli", "name": "Kilo CLI", "bins": ["kilo", "kilocode"], "version_args": ["--version"],
     "detect": ["{home}/.config/kilo"],
     "config": "{home}/.config/kilo/kilo.jsonc", "format": "json", "key": "mcp", "entry": "opencode"},
    {"id": "opencode", "name": "OpenCode", "bins": ["opencode"], "version_args": ["--version"],
     "detect": ["{home}/.config/opencode"],
     "config": "{home}/.config/opencode/opencode.json", "format": "json", "key": "mcp",
     "entry": "opencode"},
    {"id": "codex", "name": "Codex CLI", "bins": ["codex"], "version_args": ["--version"],
     "detect": ["{home}/.codex"],
     "config": "{home}/.codex/config.toml", "format": "toml", "key": "mcp_servers", "entry": "codex",
     "entry_extra": {"tool_timeout_sec": 1800}},
    {"id": "gemini", "name": "Gemini CLI", "bins": ["gemini"], "version_args": ["--version"],
     "detect": ["{home}/.gemini"],
     "config": "{home}/.gemini/settings.json", "format": "json", "key": "mcpServers",
     "entry": "standard", "entry_extra": {"timeout": 1800000}},
    {"id": "qwen", "name": "Qwen Code", "bins": ["qwen"], "version_args": ["--version"],
     "detect": ["{home}/.qwen"],
     "config": "{home}/.qwen/settings.json", "format": "json", "key": "mcpServers",
     "entry": "standard", "entry_extra": {"timeout": 1800000}},
    {"id": "continue", "name": "Continue", "bins": ["cn"], "version_args": ["--version"],
     "detect": ["{home}/.continue"],
     "config": "{home}/.continue/mcpServers/aurora.yaml", "format": "continue", "key": "mcpServers",
     "entry": "continue", "note": "Свой файл в ~/.continue/mcpServers/ — общий config.yaml не трогается."},
    {"id": "zed", "name": "Zed", "bins": ["zed"], "version_args": ["--version"],
     "detect": ["{home}/.config/zed", "/Applications/Zed.app"],
     "config": "{home}/.config/zed/settings.json", "config_windows": "{appdata}/Zed/settings.json",
     "format": "json", "key": "context_servers", "entry": "zed"},
    {"id": "jcode", "name": "jcode", "bins": ["jcode"], "version_args": ["--version"],
     "detect": ["{home}/.jcode"],
     "config": "{home}/.jcode/mcp.json", "format": "json", "key": "mcpServers", "entry": "standard",
     "entry_extra": {"timeout_secs": 1800},
     "note": "По умолчанию jcode ждёт инструмент 30 с — запись ставит 1800 с: ревью идёт минуты."},
    {"id": "hermes", "name": "Hermes Agent", "bins": ["hermes"], "version_args": ["--version"],
     "detect": ["{home}/.hermes"],
     "config": "{home}/.hermes/config.yaml", "format": "yaml", "key": "mcp_servers",
     "entry": "hermes", "entry_extra": {"timeout": 1800}},
    {"id": "goose", "name": "Goose", "bins": ["goose"], "version_args": ["--version"],
     "detect": ["{home}/.config/goose"],
     "config": "{home}/.config/goose/config.yaml", "config_windows": "{appdata}/Block/goose/config/config.yaml",
     "format": "yaml", "key": "extensions", "entry": "goose", "entry_extra": {"timeout": 1800}},
    {"id": "crush", "name": "Crush", "bins": ["crush"], "version_args": ["--version"],
     "detect": ["{home}/.config/crush"],
     "config": "{home}/.config/crush/crush.json", "format": "json", "key": "mcp", "entry": "crush"},
    {"id": "pi", "name": "pi", "bins": ["pi"], "version_args": ["--version"],
     "detect": ["{home}/.pi/agent"],
     "config": "{home}/.pi/agent/mcp.json", "format": "json", "key": "mcpServers", "entry": "standard",
     "note": "pi подключает MCP расширением pi-mcp-extension — без него запись не действует."},
    {"id": "deepseek", "name": "DeepSeek TUI", "bins": ["deepseek", "deepseek-tui"],
     "version_args": ["--version"], "detect": ["{home}/.deepseek", "{home}/.codewhale"],
     "config": "{home}/.deepseek/mcp.json", "format": "json", "key": "mcpServers", "entry": "standard"},
    {"id": "kiro", "name": "Kiro", "bins": ["kiro"], "version_args": ["--version"],
     "detect": ["{home}/.kiro"],
     "config": "{home}/.kiro/settings/mcp.json", "format": "json", "key": "mcpServers",
     "entry": "standard"},
    {"id": "amp", "name": "Amp", "bins": ["amp"], "version_args": ["--version"],
     "detect": ["{home}/.config/amp"],
     "config": "{home}/.config/amp/settings.json", "format": "json", "key": "amp.mcpServers",
     "entry": "standard"},
    {"id": "lmstudio", "name": "LM Studio", "bins": ["lms"], "version_args": ["version"],
     "detect": ["{home}/.lmstudio"],
     "config": "{home}/.lmstudio/mcp.json", "format": "json", "key": "mcpServers", "entry": "standard"},
    {"id": "junie", "name": "Junie (JetBrains)", "bins": [],
     "detect": ["{home}/.junie"],
     "config": "{home}/.junie/mcp/mcp.json", "format": "json", "key": "mcpServers", "entry": "standard"},
    {"id": "chatbox", "name": "Chatbox", "bins": [],
     "detect": ["{appdata}/xyz.chatboxapp.app", "/Applications/Chatbox.app"],
     "config": "{appdata}/xyz.chatboxapp.app/config.json", "format": "chatbox",
     "key": "settings.mcp.servers", "entry": "chatbox", "process": ["Chatbox"],
     "note": "Не агент, а чат-клиент, но MCP умеет: сервер aurora появится в «Настройки → MCP». Подключать при закрытом Chatbox — при выходе он переписывает файл настроек. Инструменты ревью идут минуты: если Chatbox оборвёт вызов, поднимите срок ожидания в его настройках."}
  ]
}

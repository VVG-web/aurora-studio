.DS_Store
.env
.env.*
.mcp.json
__pycache__/
*.pyc
.ruff_cache/
~$*
*.log
/tmp/

# Приватный слой: имена проектов, контуры, живые числа. Наружу уходит только обезличенное.
local/

# Кухня разработки движка: тест-кейсы и сценарии QA, черновики, заметки по доработкам.
# В открытую поставку это не идёт — там инструмент, а не то, как мы его проверяем.
Development/
*.local.md
*.local.txt

# Отпечаток работающей панели: адрес с токеном сессии
cockpit/.session.json
cockpit/.registry-cache.json

# Следы прогонов движка внутри самого кита: команды рассчитаны на проект и создают его
# папки там, откуда их запустили. В поставку это попадать не должно — кит не проект.
AuroraKnowledgeDB/
scripts/AuroraKnowledgeDB/
Sources/
Raw/
Artifacts/
Deliverables/
Workspaces/
.opencode/
aurora.config.yaml
!tests/corpus/**

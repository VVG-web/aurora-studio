.DS_Store
.env
.env.*
.mcp.json
__pycache__/
*.pyc
.ruff_cache/
~$*
*.log
/tmp/

# Приватный слой: имена проектов, контуры, живые числа. Наружу уходит только обезличенное.
local/

# Кухня разработки движка: тест-кейсы и сценарии QA, черновики, заметки по доработкам.
# В открытую поставку это не идёт — там инструмент, а не то, как мы его проверяем.
#
# Папка при этом НЕ бесхозная: она смонтирована как git worktree на локальную ветку
# `development`. История есть, наружу не уходит. Восстановить после клона:
#     git worktree add Development development
# Пуш этой ветки в публичный origin блокирует хук `.git/hooks/pre-push`.
Development/
*.local.md
*.local.txt

# Отпечаток работающей панели: адрес с токеном сессии
cockpit/.session.json
cockpit/.registry-cache.json

# Состояние идущего прогона: там лежит имя живого проекта («project»: «...»).
# Отслеживался до 1.100.1 и утёк в публичную историю — рядом с .session.json ему и место.
cockpit/.running.json

# Следы прогонов движка внутри самого кита: команды рассчитаны на проект и создают его
# папки там, откуда их запустили. В поставку это попадать не должно — кит не проект.
AuroraKnowledgeDB/
scripts/AuroraKnowledgeDB/
Sources/
Raw/
Artifacts/
Deliverables/
Workspaces/
.opencode/
aurora.config.yaml
!tests/corpus/**

# Состояние последней проверки связи — результат прогона, а не исходник:
# отслеживание делало грязным дерево после каждого запуска тестов.
ping-state.json

# Рабочие папки других инструментов: там живут заметки прогонов с именами проектов
# и адресами контура — в публичный репозиторий кита им нельзя.
.sisyphus/

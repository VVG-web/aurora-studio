{
  "id": "jira-dc",
  "title": "Jira (Server / Data Center)",
  "kind": "board",
  "role": "tasks",
  "service_role": "tasktracker",
  "aliases": ["jira"],
  "since": "1.28.0",
  "what": "Задачи по JQL: файл на задачу, имя — ключ. Состояние копится между прогонами, поэтому узкий запрос не выбрасывает остальное из зеркала.",
  "mirror": {
    "default_path": "Sources/JIRA",
    "state": "update_log.md",
    "legacy_path_key": "sources_jira"
  },
  "run": {
    "script": "jira_export.py",
    "command": "sync:jira",
    "skill": "jira-export"
  },
  "operations": {
    "role": "tasks",
    "script": "jira_ops.py",
    "ops": ["issue_types", "epics", "find_user", "create_issue", "link_page", "get_issue"],
    "server": "base_url",
    "defaults": {"project_key": "project_key"}
  },
  "auth": {
    "env_prefix": "JIRA",
    "what": "персональный токен Jira (JIRA_PAT) либо JIRA_USER + JIRA_PASSWORD"
  },
  "settings_block": "atlassian.jira",
  "settings": [
    {
      "key": "base_url",
      "what": "адрес сервера Jira",
      "required": true
    },
    {
      "key": "project_key",
      "what": "ключ проекта"
    },
    {
      "key": "default_jql",
      "what": "запрос по умолчанию"
    }
  ],
  "requires": {
    "python": []
  },
  "role_what": "задачи трекера: их статус решает, доверять ли артефакту"
}

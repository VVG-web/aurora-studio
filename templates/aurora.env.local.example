# Личные учётные данные для скриптов Авроры на ЭТОЙ машине.
# Скопируйте в `.env.aurora.local` рядом с aurora.config.yaml и заполните значения.
# Файл закрыт .gitignore — в репозиторий он не уедет. В git секреты не кладём никогда.
#
# Зачем это нужно, если Atlassian уже настроен в Cursor: MCP живёт внутри редактора и
# наружу свои учётные данные не отдаёт. Скрипты синка ходят в Confluence и Jira напрямую
# по REST, поэтому им нужен собственный доступ. Токен — тот же самый, что прописан
# в mcp-atlassian (`~/.cursor/mcp.json` → mcpServers → mcp-atlassian → env), имена
# переменных совпадают.
#
# Адреса и пространства сюда НЕ пишутся: base_url, space, project_key и JQL живут
# в aurora.config.yaml — он один на всю команду.

# --- Confluence: sync:confluence, ship:publish -------------------------------
# Data Center 7.9+ / Server: персональный токен
# (Confluence → Профиль → Personal Access Tokens → Create token)
CONFLUENCE_PERSONAL_TOKEN=

# Синоним, если короткое имя удобнее (достаточно любого одного):
# CONFLUENCE_PAT=

# Запасной вариант для версий, где PAT недоступен:
# CONFLUENCE_USER=
# CONFLUENCE_PASSWORD=

# --- Jira: sync:jira, sync:jira-status ---------------------------------------
# Jira Server / Data Center: персональный токен
# (Jira → Профиль → Personal Access Tokens)
JIRA_PERSONAL_TOKEN=

# Синоним:
# JIRA_PAT=

# Запасной вариант:
# JIRA_USER=
# JIRA_PASSWORD=

# Больше движок из окружения ничего не читает: восемь переменных выше — весь список.
# Проверка: python3 .opencode/scripts/jira_export.py --limit 1 покажет, принят ли токен.

# --- Встроенный агент (LLM) ---------------------------------------------------
# Все настройки агента — здесь же, одним механизмом: значения из этого файла проекта
# переопределяют глобальные из .env.aurora.local в папке kit'а. Проверка: agent:ping.
# Бэкенды — упорядоченная цепочка-кольцо: каждый вызов идёт с первого; недоступный или
# занятый пропускается, восстановившийся подхватывается на следующем запросе.
#
# AURORA_AGENT_ADAPTER=pydantic_ai         # или openai_compat (stdlib, без venv)
# AURORA_AGENT_THINKING=1                  # рассуждения моделей включены
# AURORA_AGENT_MAX_STEPS=15
# AURORA_AGENT_BUDGET_MIN=20
# AURORA_AGENT_REQUEST_TIMEOUT=300
#
# AURORA_AGENT_BACKEND_1_URL=https://llm.example.com/v1
# AURORA_AGENT_BACKEND_1_KEY=<ключ, если шлюз его требует>
# AURORA_AGENT_BACKEND_1_MODEL_WORKER=<модель для рутинных шагов>
# AURORA_AGENT_BACKEND_1_MODEL_PLANNER=<модель-планировщик>
# AURORA_AGENT_BACKEND_1_MODEL_CRITIC=<модель-критик>
# AURORA_AGENT_BACKEND_1_MODEL_QA=<модель-проверяющий>
#
# AURORA_AGENT_BACKEND_2_URL=http://<ip-локального-сервера>:8081/v1
# AURORA_AGENT_BACKEND_2_MODEL=<одна модель на все роли — так тоже можно>

# Эмбеддинги для поиска по смыслу (kb:embed). Адрес пуст — вектора считает то же кольцо,
# что и чат: в инфраструктуре с одним шлюзом здесь ничего не нужно. Заполняйте, когда
# модель векторов поднята отдельным сервисом (TEI, свой vLLM) — у него другой адрес и
# часто нет ключа.
# AURORA_EMBED_MODEL=bge-m3
# AURORA_EMBED_URL=http://vectors.example.com/v1
# AURORA_EMBED_KEY=
#
# Кольцо векторов НЕ зависит от кольца чата: модель чата может работать на одном шлюзе,
# а вектора считаться на другом. Объявите на шлюзе модель векторов — и он войдёт в кольцо
# эмбеддингов; если чат-модели у него нет, в чатовое кольцо он не попадёт вовсе.
# Номера идут с пропусками: чат на №2, вектора на №4 — рабочая настройка.
# Пропуск можно использовать и намеренно. Движки до 1.103.0 читают шлюзы подряд и
# останавливаются на первой дыре: объявив векторный шлюз под номером ПОСЛЕ пропуска,
# вы получаете его в ките сразу, а проекты, где движок ещё не обновлён, его не увидят —
# и не позовут чатом (старый движок в обычном вызове обходит все шлюзы подряд).
# AURORA_AGENT_BACKEND_4_URL=http://vectors.example.com/v1
# AURORA_AGENT_BACKEND_4_EMBED_MODEL=bge-m3
# Адрес векторов, если он отличается от чатового на том же шлюзе:
# AURORA_AGENT_BACKEND_4_EMBED_URL=
#
# Считать ли вектора на ЗАПАСНЫХ шлюзах, когда первый молчит. По умолчанию нет.
# Берётся только шлюз, объявивший ТУ ЖЕ модель: вектора разных моделей лежат в разных
# пространствах, и подмена не ломает поиск заметно — он просто перестаёт находить.
# AURORA_EMBED_FALLBACK=1

# --- Распознавание сканов (kb:ingest-office) ------------------------------------
# PDF без текстового слоя — это картинки: парсеры достают из него ноль знаков. Такие
# страницы отрисовываются и читаются ЗРЯЧЕЙ моделью. Кольцо третье и независимое: ни чат,
# ни вектора к нему отношения не имеют.
#
# Модель не названа — путь выключен, и скан честно остаётся неразобранным. Умолчания тут
# быть не может: угаданное имя модели даёт не отказ, а связную выдумку в транскрипте
# первоисточника, и отличить её от настоящего текста потом нечем.
# AURORA_OCR_MODEL=glm-ocr
# AURORA_AGENT_BACKEND_1_OCR_MODEL=glm-ocr
# Адрес распознавания, если он отличается от чатового на том же шлюзе:
# AURORA_AGENT_BACKEND_1_OCR_URL=
# Свой сервис распознавания (идёт первым в кольце):
# AURORA_OCR_URL=
# AURORA_OCR_KEY=
#
# Плотность отрисовки страницы: 130 точек на дюйм — текст читается, а страница А4 весит
# около 190 КБ и запрос не упирается в потолок шлюза.
# AURORA_OCR_DPI=130
# Потолок страниц на файл: распознавание — это вызов модели на КАЖДУЮ страницу.
# AURORA_OCR_MAX_PAGES=60
# Переходить ли к следующему зрячему шлюзу, когда первый молчит. По умолчанию нет.
# AURORA_OCR_FALLBACK=1

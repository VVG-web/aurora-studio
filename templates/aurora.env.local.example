# Личные учётные данные для скриптов Авроры на ЭТОЙ машине.
# Скопируйте в `.env.aurora.local` рядом с aurora.config.yaml и заполните значения.
# Файл закрыт .gitignore — в репозиторий он не уедет. В git секреты не кладём никогда.
#
# Зачем это нужно, если Atlassian уже настроен в Cursor: MCP живёт внутри редактора и
# наружу свои учётные данные не отдаёт. Скрипты синка ходят в Confluence и Jira напрямую
# по REST, поэтому им нужен собственный доступ. Токен — тот же самый, что прописан
# в mcp-atlassian (`~/.cursor/mcp.json` → mcpServers → mcp-atlassian → env), имена
# переменных совпадают.
#
# Адреса и пространства сюда НЕ пишутся: base_url, space, project_key и JQL живут
# в aurora.config.yaml — он один на всю команду.

# --- Confluence: sync:confluence, ship:publish -------------------------------
# Data Center 7.9+ / Server: персональный токен
# (Confluence → Профиль → Personal Access Tokens → Create token)
CONFLUENCE_PERSONAL_TOKEN=

# Синоним, если короткое имя удобнее (достаточно любого одного):
# CONFLUENCE_PAT=

# Запасной вариант для версий, где PAT недоступен:
# CONFLUENCE_USER=
# CONFLUENCE_PASSWORD=

# --- Jira: sync:jira, sync:jira-status ---------------------------------------
# Jira Server / Data Center: персональный токен
# (Jira → Профиль → Personal Access Tokens)
JIRA_PERSONAL_TOKEN=

# Синоним:
# JIRA_PAT=

# Запасной вариант:
# JIRA_USER=
# JIRA_PASSWORD=

# Больше движок из окружения ничего не читает: восемь переменных выше — весь список.
# Проверка: python3 .opencode/scripts/jira_export.py --limit 1 покажет, принят ли токен.

# --- Встроенный агент (LLM) ---------------------------------------------------
# Все настройки агента — здесь же, одним механизмом: значения из этого файла проекта
# переопределяют глобальные из .env.aurora.local в папке kit'а. Проверка: agent:ping.
# Бэкенды — упорядоченная цепочка-кольцо: каждый вызов идёт с первого; недоступный или
# занятый пропускается, восстановившийся подхватывается на следующем запросе.
#
# AURORA_AGENT_ADAPTER=pydantic_ai         # или openai_compat (stdlib, без venv)
# AURORA_AGENT_THINKING=1                  # рассуждения моделей включены
# AURORA_AGENT_MAX_STEPS=15
# AURORA_AGENT_BUDGET_MIN=20
# AURORA_AGENT_REQUEST_TIMEOUT=300
#
# AURORA_AGENT_BACKEND_1_URL=https://llm.example.com/v1
# AURORA_AGENT_BACKEND_1_KEY=<ключ, если шлюз его требует>
# AURORA_AGENT_BACKEND_1_MODEL_WORKER=<модель для рутинных шагов>
# AURORA_AGENT_BACKEND_1_MODEL_PLANNER=<модель-планировщик>
# AURORA_AGENT_BACKEND_1_MODEL_CRITIC=<модель-критик>
# AURORA_AGENT_BACKEND_1_MODEL_QA=<модель-проверяющий>
#
# AURORA_AGENT_BACKEND_2_URL=http://<ip-локального-сервера>:8081/v1
# AURORA_AGENT_BACKEND_2_MODEL=<одна модель на все роли — так тоже можно>

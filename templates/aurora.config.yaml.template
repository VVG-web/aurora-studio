# Aurora project configuration (committed). Schema version 1.
# Personal secrets: copy aurora.env.local.example → .env.aurora.local (gitignored).
# Agents and sync skills MUST read project constants from this file — do not hardcode space/JQL in skill bodies.

aurora:
  version: 1

project:
  name: "{{PROJECT_NAME}}"
  slug: "{{PROJECT_SLUG}}"

skills:
  required:
    - name: aurora-vault
      via: repo   # .opencode/skills/aurora-vault/
  recommended:
    - name: mcp-atlassian
      via: cursor-mcp
      note: "Authenticate in Cursor MCP with YOUR Atlassian account (never commit tokens)."
    - name: "confluence-sync-{{PROJECT_SLUG}}"
      via: repo
    - name: "jira-export-{{PROJECT_SLUG}}"
      via: repo

# Подключённые модули источников: id — он же имя папки в Sources/.
# Что установлено: `python3 .opencode/scripts/sources_registry.py`.
# Секции нет — работают модули, встроенные в kit (Confluence и Jira).
sources:
  - id: Confluence
    module: confluence-dc
    path: Sources/Confluence
  - id: JIRA
    module: jira-dc
    path: Sources/JIRA

atlassian:
  confluence:
    base_url: "https://confluence.example.com"
    space: "{{CONFLUENCE_SPACE}}"
    # Primary sync roots (page_id preferred). sync_paths.md may mirror these.
    sync_roots: []
    # Example:
    # sync_roots:
    #   - page_id: "123456"
    #     title: "Root page"
    #     url: "https://confluence.example.com/pages/viewpage.action?pageId=123456"
  jira:
    base_url: "https://jira.example.com"
    project_key: "{{JIRA_KEY}}"
    default_jql: "project = {{JIRA_KEY}} ORDER BY updated DESC"
    # Статусы этого проекта, означающие «сделано» и «отменено» — для sync:jira-status.
    # Всё, чего движок не знает, он считает открытым и печатает отдельным списком.
    done_statuses: []        # например: [Готово, Закрыто, "Тестирование - готово"]
    cancelled_statuses: []   # например: [Отменено, "Won't do"]
    # Доверие по статусу задачи (`kb:verify --by-jira`). История, дошедшая до разработки
    # и тестирования, прошла разбор аналитика и приёмку постановки — на этом основании
    # карточка получает `verified`. Списки проектные: у каждой команды свой процесс.
    trust_statuses: []       # например: [Разработка, Тестирование, Закрыто]
    assumption_statuses: []  # например: [Бэклог, Сделать, Аналитика]
  auth:
    mode: mcp_user   # tokens never live in this file or in skills

paths:
  knowledge_db: AuroraKnowledgeDB
  sources_confluence: Sources/Confluence
  sources_jira: Sources/JIRA

verify:
  # Доверие по происхождению (`kb:verify --by-source`). Карточка, собранная из договора,
  # ТЗ или материалов заказчика, пересказывает документ, который уже подписан, — решать
  # по ней нечего. То же со словарём: термин и справочник не выводы, а именование.
  # Списки проектные: что у одного заказчика доказательство, у другого черновик.
  trusted_sources: []      # например: [Raw/contract, Raw/customer, Raw/project]
  trusted_sections: []     # например: [Glossary, Reference, Statuses]

privacy:
  # Режим kb:scrub. Зависит от контура, а не от вкусов: если репозиторий уезжает
  # в закрытый git или on-prem, а те же тексты и так открыты команде в Confluence,
  # маскировать нечего — и лишние маркеры только портят документы.
  #   off    — не искать (одноразово посмотреть всё равно можно: --force)
  #   report — искать и показывать, маскирование только руками (по умолчанию)
  #   mask   — маскирование ожидается: kb:scrub --apply и проверка перед публикацией
  scrub: report
  mask_contacts: false   # почта в Reporter:/Assignee: — атрибуция, не ПДн
  include_raw: false     # Raw/ и released/ — доказательства, правка ломает неизменяемость

bootstrap:
  verified_threshold_pct: 20
